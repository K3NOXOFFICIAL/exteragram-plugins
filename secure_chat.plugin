import os
import hashlib
import struct
import hmac

__id__ = "secure_chat"
__name__ = "Secure Chat"
__description__ = "A plugin that provides end-to-end encrypted chat functionality."
__author__ = "@abyn0x & @setsufluff"
__version__ = "1.2.4"
__icon__ = "exteraPlugins/1"
__min_version__ = "11.12.0"

MAGIC_HEADER = "##secure_chat##:"
REPLACE_MESSAGES_OBJECTS = 10
 
class SecureChatPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.chat_keys = {}

    def on_plugin_load(self):
       
        try:
            from hook_utils import find_class
            NC = find_class("org.telegram.messenger.NotificationCenter")
            REPLACE_MESSAGES_OBJECTS = NC.replaceMessagesObjects
            self.log(f"Setting NotificationCenter replaceMessagesObjects to {REPLACE_MESSAGES_OBJECTS}")
        except Exception:
            self.log("Could not find NotificationCenter")

        class ChatMessageCellMeasureTimeHook:
            def __init__(self, plugin):
                self.plugin = plugin

            def before_hooked_method(self, param):
                try:
                    if not param.args or len(param.args) == 0:
                        return

                    messageObject = param.args[0]
                    if not messageObject or not messageObject.messageOwner:
                        return

                    raw_text = messageObject.messageOwner.message
                    if not isinstance(raw_text, str):
                        return
                                        
                    message_id = messageObject.getId()
                    dialog_id = messageObject.getDialogId()

                    if raw_text.startswith(MAGIC_HEADER):
                        messageObject.messageOwner.edit_date = int(time.time())
                        messageObject.messageOwner.flags |= 32768
                        # remove MAGIC_HEADER and decrypt the message on our local client
                        try:
                            if dialog_id and str(dialog_id) in self.plugin.chat_keys:
                                chat_key = self.plugin.chat_keys[str(dialog_id)]
                                decrypted = decrypt(raw_text[len(MAGIC_HEADER):], chat_key)
                            else:
                                decrypted = "[NO KEY]"+raw_text
                        except Exception:
                            decrypted = "[ERROR] "+raw_text
                        messageObject.applyNewText(str(f"[ENCRYPTED] {decrypted}"))

                        messages_arr = ArrayList()
                        messages_arr.add(messageObject)

                        def update_ui():
                            try:
                                get_notification_center().postNotificationName(
                                    REPLACE_MESSAGES_OBJECTS,
                                    messageObject.getDialogId(),
                                    messages_arr,
                                    False,
                                )
                            except Exception as e:
                                self.log(e)
                                pass
                        run_on_ui_thread(update_ui)
                except Exception as e:
                    self.log(e)
                    pass
        self.add_on_send_message_hook(priority=100)
        try:
            method_measure = ChatMessageCell.getClass().getDeclaredMethod(
                "measureTime", MessageObject
            )
            self.hook_method(method_measure, ChatMessageCellMeasureTimeHook(self))
        except Exception as e:
            self.log(e)
            pass

        try:
            chat_keys_data = self.get_setting("chat_keys", "{}")
            self.chat_keys = (
                json.loads(chat_keys_data) if isinstance(chat_keys_data, str) else {}
            )
        except:
            self.log("No Keys loaded")
            self.chat_keys = {}

        menu_item = MenuItemData(
                    menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                    text="Message",
                    icon="msg_secret",
                    on_click=self._click,
                )
        self.add_menu_item(menu_item)
        menu_item = MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text="chatAction",
                    icon="msg_secret",
                    priority=15,
                    on_click=self._click,
                )
        self.add_menu_item(menu_item)
        menu_item = MenuItemData(
                    menu_type=MenuItemType.DRAWER_MENU,
                    text="Drawer",
                    icon="msg_secret",
                    priority=15,
                    on_click=self._click,
                )
        self.add_menu_item(menu_item)
        menu_item = MenuItemData(
                    menu_type=MenuItemType.PROFILE_ACTION_MENU,
                    text="Profile",
                    icon="msg_secret",
                    on_click=self._click,
                )
        self.add_menu_item(menu_item)
        
        self.log("Plugin loaded!")
        pass
 
    def on_plugin_unload(self):
        # e.g. unregister hooks, clean up resources
        self.log("Plugin unloaded!")
        pass

    def save_chat_keys(self):
        self.set_setting("chat_keys", json.dumps(self.chat_keys))

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not hasattr(params, 'message') or not isinstance(params.message, str):
            return HookResult()
        
        message = params.message.strip()
        if not message:
            return HookResult()
        
        if not message.startswith("."):
            return HookResult()
        dialog_id = getattr(params, 'peer', None) or getattr(params, 'dialog_id', None)
        
        if message.startswith(".enc") or message.startswith(".encrypt"):
            if dialog_id and str(dialog_id) in self.chat_keys:
                chat_key = self.chat_keys[str(dialog_id)]
                params.message = MAGIC_HEADER + encrypt(message[len(".enc"):].lstrip(), chat_key)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            else:
                run_on_ui_thread(lambda: BulletinHelper.show_error("Unknown chat key! canceled"))
            return HookResult(strategy=HookStrategy.CANCEL)
        if message.startswith(".setkey"):
            self.chat_keys[str(dialog_id)] = message[len(".setkey"):]
            self.save_chat_keys()
            run_on_ui_thread(lambda: BulletinHelper.show_error("Chat key updated :3"))
            return HookResult(strategy=HookStrategy.CANCEL)
        return HookResult()
    
    def _click(self, context: Dict[str, Any]):
        run_on_ui_thread(lambda: BulletinHelper.show_error("Chat key updated :3"))
    
    def _confirm_clear_all_keys(self):
        def show():
            fragment = get_last_fragment()
            if not fragment or not (activity := fragment.getParentActivity()):
                return

            dialog = AlertDialogBuilder(activity)
            dialog.set_title("Clear all keys?")
            dialog.set_message("Do you really want to clear all encryption keys?\nThis cannot be undone...")

            dialog.set_positive_button(
                "Yes delete them all",
                lambda d, w: (d.dismiss(), self._clear_all_chat_keys()),
            )
            dialog.set_negative_button(
                "hell no", lambda d, w: d.dismiss()
            )
            dialog.show()
        run_on_ui_thread(show)
    
    def _show_chat_keys_manager(self):
        def show():
            fragment = get_last_fragment()
            if not fragment or not (activity := fragment.getParentActivity()):
                return

            dialog = AlertDialogBuilder(activity)
            dialog.set_title("Chat keys")

            if not self.chat_keys:
                dialog.set_message("No chat keys found")
                dialog.set_positive_button("close", lambda d, _: d.dismiss())
            else:
                keys_list = ""
                for dialog_id, key in self.chat_keys.items():
                    truncated_key = key[:16] + "..." if len(key) > 16 else key
                    keys_list += "Chat {id} is using {key}\n".format(
                        id=dialog_id, key=truncated_key
                    )

                message = "Chat keys ({count}):\n\n{list}".format(
                    count=len(self.chat_keys), list=keys_list
                )
                dialog.set_message(message)

                dialog.set_neutral_button(
                    "Clear keys",
                    lambda d, w: (d.dismiss(), self._confirm_clear_all_keys()),
                )

                #dialog.set_positive_button(
                #    self._get_string("dialog_manage_chat_keys"),
                #    lambda d, w: (d.dismiss(), self._show_manage_keys_dialog()),
                #)
                dialog.set_negative_button("Close", lambda d, _: d.dismiss())
            dialog.show()
        run_on_ui_thread(show)
    
    def create_settings(self):
        return [
            Header(text="General Settings"),
            Text(
                text="Manage chat keys",
                icon="msg_groups",
                accent=True,
                on_click=lambda _: self._show_chat_keys_manager(),
            ),  
        ]

# =============================================================================
# ENCRYPTION/DECRYPTION UTILITY FUNCTIONS [Written By ABYNOX]
# =============================================================================

def derive_key(password: str, salt: bytes) -> bytes:
    """Derive a 256-bit key from password and salt using scrypt"""
    return hashlib.scrypt(password.encode("utf-8"), salt=salt, n=2**14, r=8, p=1, dklen=32)

def encrypt(text: str, password: str) -> str:
    """Encrypt text using password-based encryption"""
    salt = os.urandom(16)  # Generate random salt
    nonce = os.urandom(12)  # Generate random nonce
    # Derive key from password + salt
    key = derive_key(password, salt)

    cipher = ChaCha20Poly1305(key)
    ciphertext = cipher.encrypt(nonce, text.encode("utf-8"), None)

    # Store salt + nonce + ciphertext (all needed for decryption)
    return base64.b64encode(salt + nonce + ciphertext).decode()

def decrypt(b64text: str, password: str) -> str:
    """Decrypt base64-encoded text using password"""
    data = base64.b64decode(b64text)
    if len(data) < 16 + 12 + 16:  # salt + nonce + auth tag
        return None
    salt = data[:16]
    nonce = data[16:28]
    ciphertext = data[28:]

    # Re-derive key from password + salt
    key = derive_key(password, salt)

    cipher = ChaCha20Poly1305(key)
    plaintext = cipher.decrypt(nonce, ciphertext, None)
    return plaintext.decode("utf-8")















































