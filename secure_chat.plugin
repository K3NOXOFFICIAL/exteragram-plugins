from base_plugin import BasePlugin, HookResult, HookStrategy, MenuItemType, MenuItemData
from typing import Any, Dict
import base64
import time
from client_utils import get_notification_center, get_last_fragment
from android_utils import run_on_ui_thread
from ui.bulletin import BulletinHelper
from ui.alert import AlertDialogBuilder
import json
from ui.settings import Header, Input, Divider, Switch, Selector, Text, EditText
from java.util import ArrayList  # type: ignore
